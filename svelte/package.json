{
	"name": "auth",
	"version": "0.9.0",
	"type": "module",
	"scripts": {
		"dev:frontend": "vite dev",
		"dev:backend": "npx convex dev",
		"dev": "concurrently --kill-others --prefix-colors blue,yellow --names 'vite,convex' 'pnpm dev:frontend' 'pnpm dev:backend'",
		"build": "vite build",
		"preview": "vite preview",
		"postinstall": "svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"vercel:link": "cross-env-shell \"vercel link --yes --token $VERCEL_TOKEN --scope etesie\"",
		"vercel:pull": "cross-env-shell \"vercel env pull --token $VERCEL_TOKEN --scope etesie\"",
		"init:repo": "pnpm config set auto-install-peers true && pnpm install && cross-env-shell \"vercel link --yes --token $VERCEL_TOKEN --scope etesie && vercel env pull --token $VERCEL_TOKEN --scope etesie\" && pnpm dev",
		"pull:convex": "rm -rf ./src/convex && cp -r ../convex ./src/convex",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"ci:release": "jsrepo publish && changeset tag"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.0",
		"@convex-dev/eslint-plugin": "^2.0.0",
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^0.577.0",
		"@skeletonlabs/skeleton": "4.15.2",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.67.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/postcss": "^4.3.1",
		"@tailwindcss/typography": "^0.5.20",
		"@types/node": "^25.9.4",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.3",
		"cross-env": "^10.1.0",
		"eslint": "^10.5.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.7.0",
		"jsrepo": "^3.8.0",
		"mode-watcher": "^1.1.0",
		"prettier": "^3.8.4",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.4",
		"svelte-check": "^4.7.1",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.3.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.0",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "^8.1.0",
		"vitest": "^4.1.9"
	},
	"dependencies": {
		"@ark-ui/svelte": "^5.22.1",
		"@better-auth/api-key": "1.6.16",
		"@convex-dev/better-auth": "0.12.4",
		"@convex-dev/migrations": "^0.3.5",
		"@convex-dev/resend": "0.2.5",
		"@icons-pack/svelte-simple-icons": "^6.5.0",
		"@mmailaender/convex-better-auth-svelte": "^0.8.0",
		"@tailwindcss/vite": "^4.3.1",
		"@zxcvbn-ts/core": "^4.1.2",
		"@zxcvbn-ts/language-common": "^4.1.2",
		"@zxcvbn-ts/language-en": "^4.1.1",
		"better-auth": "1.6.16",
		"convex": "^1.42.0",
		"convex-helpers": "^0.1.120",
		"convex-svelte": "^0.14.0",
		"path-to-regexp": "^8.4.2",
		"runed": "^0.37.1",
		"svelte-easy-crop": "^5.0.1",
		"svelte-toolbelt": "^0.10.6"
	},
	"packageManager": "pnpm@11.9.0"
}
